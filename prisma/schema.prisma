generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ATHLETE
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(ATHLETE)
  isApproved Boolean  @default(false)
  athleteId  String?  @unique
  athlete    Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("users")
}

model Athlete {
  id            String   @id @default(uuid())
  name          String
  age           Int
  dateOfBirth   DateTime?
  weightClass   String
  classGroup    String   @default("Reguler")
  gender        String   @default("Laki-laki")
  belt          String   @default("Putih")
  overallRating Int
  status        String
  createdAt     DateTime @default(now())

  physicalMetrics PhysicalMetric[]
  combatStats     CombatStat?
  radarAttributes RadarAttribute?
  user            User?
  missions        MissionProgress[]
  attendances              Attendance[]
  matches                  Match[]
  tournamentParticipations TournamentParticipant[]

  @@map("athletes")
}

model PhysicalMetric {
  id          String   @id @default(uuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date        String
  bpm         Int
  runningPace Float
  impactForce Float
  restHours   Float
  createdAt   DateTime @default(now())

  @@map("physical_metrics")
}

model CombatStat {
  id              String  @id @default(uuid())
  athleteId       String  @unique
  athlete         Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  matchesPlayed   Int     @default(0)
  headshotAcc     Float
  bodyKickAcc     Float
  blockPercentage Float
  fouls           Int     @default(0)
  totalPoints     Int     @default(0)

  @@map("combat_stats")
}

model RadarAttribute {
  id        String  @id @default(uuid())
  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  power     Int
  speed     Int
  stamina   Int
  agility   Int
  technique Int
  defense   Int

  @@map("radar_attributes")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String
  targetDate  DateTime
  createdAt   DateTime @default(now())
  
  progress    MissionProgress[]

  @@map("missions")
}

model MissionProgress {
  id          String   @id @default(uuid())
  missionId   String
  athleteId   String
  isDone      Boolean  @default(false)
  resultNote  String?  @db.Text
  completedAt DateTime?
  
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([missionId, athleteId])
  @@map("mission_progress")
}

model Attendance {
  id        String   @id @default(uuid())
  athleteId String
  date      String   // Format YYYY-MM-DD
  isPresent Boolean  @default(false)
  createdAt DateTime @default(now())

  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  
  @@unique([athleteId, date])
  @@map("attendance")
}

model Tournament {
  id          String   @id @default(uuid())
  name        String
  date        DateTime
  location    String?
  description String?
  createdAt   DateTime @default(now())

  matches      Match[]
  participants TournamentParticipant[]

  @@map("tournaments")
}

model Match {
  id           String   @id @default(uuid())
  tournamentId String
  athleteId    String
  opponentName String
  round        String?
  result       String
  score        String?
  notes        String?  @db.Text
  date         DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athlete      Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("matches")
}

model TournamentParticipant {
  id           String   @id @default(uuid())
  tournamentId String
  athleteId    String
  medal        String?
  registeredAt DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athlete      Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, athleteId])
  @@map("tournament_participants")
}
